{
  "name": "chatgpt-genui",
  "adapter": "chatgpt",
  "location": "https://chatgpt.com/c/00000000-0000-0000-0000-000000000004",
  "fakeDate": "2026-10-08T12:00:00Z",
  "host": "https://chatgpt.com",
  "auth": {
    "chatgpt-token": "mock-token"
  },
  "mocks": [
    {
      "method": "GET",
      "path": "/backend-api/conversation/00000000-0000-0000-0000-000000000004",
      "file": "conversation.json"
    }
  ],
  "exports": [
    {
      "name": "md-default",
      "message": {
        "kind": "export",
        "mode": "md",
        "includeReasoning": false,
        "includeDates": false,
        "dateFormat": "iso-utc",
        "inlineImages": true,
        "inlineTextFiles": false,
        "attachmentsAsMarkdown": false,
        "includeLink": true
      },
      "expectedFilename": "Generative UI-2026-10-08.md",
      "expectedContent": "expected/md-default.md"
    },
    {
      "name": "md-with-reasoning",
      "message": {
        "kind": "export",
        "mode": "md",
        "includeReasoning": true,
        "includeDates": false,
        "dateFormat": "iso-utc",
        "inlineImages": true,
        "inlineTextFiles": false,
        "attachmentsAsMarkdown": false
      },
      "expectedFilename": "Generative UI-2026-10-08.md",
      "expectedContent": "expected/md-with-reasoning.md"
    },
    {
      "name": "zip-default",
      "message": {
        "kind": "export",
        "mode": "zip",
        "includeReasoning": false,
        "includeDates": false,
        "dateFormat": "iso-utc",
        "inlineImages": false,
        "inlineTextFiles": false,
        "attachmentsAsMarkdown": false,
        "includeLink": true
      },
      "expectedFilename": "Generative UI-2026-10-08.zip",
      "expectedContent": "expected/zip-default"
    }
  ]
}
